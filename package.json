{
  "name": "support-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "ci:local": "sh scripts/ci-local.sh",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "hooks:install": "sh scripts/install-git-hooks.sh --required",
    "prepare": "sh scripts/install-git-hooks.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "llm:smoke": "pnpm --filter @support-agent/providers llm:smoke"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "tsx": "^4.22.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  }
}
