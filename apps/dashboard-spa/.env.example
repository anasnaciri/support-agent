# Vite SPA dashboard env. Copy to `.env.local` for local dev. Vite only inlines
# vars prefixed with VITE_ into the browser bundle (via import.meta.env.VITE_*),
# so EVERYTHING here is PUBLIC. Never put a secret (WORKOS_API_KEY,
# WORKOS_COOKIE_PASSWORD, API_SESSION_PASSWORD) in this file — those belong to
# apps/api only.

# Public origin of apps/api the SPA calls (reads + writes + auth). No trailing
# slash. The SPA calls apps/api directly from the browser with credentials
# (httpOnly session cookie owned by the api), so the api must allow this origin
# in its CORS allowlist.
VITE_API_BASE_URL=http://localhost:8080

# WorkOS client id (public). Used to build the sign-in/sign-up authorize URL.
VITE_WORKOS_CLIENT_ID=

# The OAuth redirect URI WorkOS sends the browser back to after login. Under the
# BFF model this is apps/api's callback (NOT a SPA route), which mints the
# session cookie and 302s back to the SPA. Register it in the WorkOS dashboard.
# Example: https://api.example.com/dashboard/auth/callback
VITE_WORKOS_REDIRECT_URI=http://localhost:8080/dashboard/auth/callback

# This SPA's own public origin, used for post-login return links. No trailing
# slash. Example: https://app-spa.example.com
VITE_SPA_ORIGIN=http://localhost:3001

# --- Production (Cloudflare) ---------------------------------------------------
# Vite inlines VITE_* at BUILD time, so the deploy build must run with the PROD
# values in its environment (there is no runtime env for a static site). e.g.:
#   VITE_API_BASE_URL=https://api.example.com \
#   VITE_WORKOS_CLIENT_ID=client_… \
#   VITE_WORKOS_REDIRECT_URI=https://api.example.com/dashboard/auth/callback \
#   VITE_SPA_ORIGIN=https://app-spa.example.com \
#   pnpm --filter @support-agent/dashboard-spa cf:deploy
# See DEPLOY.md for the WorkOS + apps/api CORS steps.
