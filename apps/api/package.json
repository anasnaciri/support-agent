{
  "name": "@support-agent/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "build:deps": "pnpm --filter '@support-agent/api...' build",
    "clean": "tsc -b --clean",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env.local dist/server.js",
    "start:dev": "pnpm run build:deps && node --env-file=.env.local --import tsx src/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@support-agent/agent-core": "workspace:*",
    "@support-agent/agents": "workspace:*",
    "@support-agent/dashboard-contracts": "workspace:*",
    "@support-agent/db": "workspace:*",
    "@support-agent/providers": "workspace:*",
    "@support-agent/services": "workspace:*",
    "@support-agent/tools": "workspace:*",
    "effect": "^3.10.0",
    "fastify": "^5.8.5",
    "jose": "^5.9.6",
    "pg-boss": "^12.18.2",
    "sanitize-html": "^2.17.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.7.0"
  }
}
