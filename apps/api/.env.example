# Copy this file to `apps/api/.env.local` or export the values in your
# process manager. Keep real secrets out of git.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Bind address for the Fastify server. Defaults to 0.0.0.0 (all interfaces,
# the usual container/proxy bind). Set to 127.0.0.1 to restrict to loopback.
API_HOST=0.0.0.0
# Pino log level (fatal|error|warn|info|debug|trace). Defaults to info;
# forced to warn when NODE_ENV=test so the suite isn't noisy.
LOG_LEVEL=info
DATABASE_URL=postgres://support_agent:support_agent@localhost:5432/support_agent

# 32-byte AES-256-GCM key, base64-encoded. Must match the worker value so
# connector credentials can be decrypted across backend processes.
CREDENTIAL_ENCRYPTION_KEY=

# HMAC key for OAuth state values in Shopify/Google install callbacks.
STATE_SIGNING_KEY=

# HMAC key for approval-link tokens. Must match apps/worker.
APPROVAL_SIGNING_KEY=

# Public origin of the dashboard (apps/dashboard). When set, a successful
# connector OAuth callback redirects the merchant back here to
# `/settings/integrations?connected=<provider>` (landing them inside the
# app, like Claude returning to its connectors page). Leave blank to keep
# the standalone `/installed` landing page served by apps/api.
# Local dev: http://localhost:3000
DASHBOARD_BASE_URL=

# WorkOS verification for the /dashboard/* API (audit S14). The dashboard
# forwards the merchant's WorkOS access token as `Authorization: Bearer <jwt>`;
# the api verifies it against WorkOS's client-scoped JWKS and reads the org/user
# from the verified claims (no shared service token, no asserted x-org-id).
# Set to the SAME WorkOS client id the dashboard uses. Blank → /dashboard/*
# routes respond 503.
WORKOS_CLIENT_ID=
# Optional overrides: a self-hosted/proxied JWKS endpoint, and a pinned issuer.
# Defaults: https://api.workos.com/sso/jwks/<WORKOS_CLIENT_ID>, issuer unpinned.
# WORKOS_JWKS_URL=
# WORKOS_JWT_ISSUER=
# WorkOS API key (same value the dashboard uses). Used ONLY to resolve a member's
# VERIFIED email (from the verified sub) when reconciling a pending invite, so
# that path never trusts the x-user-email header. Blank → invite auto-reconcile
# is a no-op (the invite stays pending) rather than falling back to the header.
WORKOS_API_KEY=

# Bearer token for the platform-operator admin endpoints (e.g.
# POST /admin/tenants/:id/delete — delete ANY tenant's account). Admin keeps
# the shared-token model (operator surface, not multi-tenant). openssl rand
# -hex 32. Blank → /admin/* routes respond 503.
ADMIN_API_TOKEN=

# ---- Shopify managed app ---------------------------------------------------
# CLIENT_ID/SECRET are the deployment-wide ("global") SaaS app. REQUIRED in
# SaaS mode; in pilot mode (SHOPIFY_CONNECT_REQUIRES_PROVISIONING=true) they
# must be LEFT BLANK — pilot is pure per-tenant provisioning with no global
# app, and the api fails to boot if they're set alongside the pilot flag.
# CALLBACK_URL/API_VERSION are always required.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_APP_CALLBACK_URL=https://<api-host>/shopify/auth/callback
SHOPIFY_API_VERSION=2026-04

# Pilot custom distribution: set to `true` so the dashboard's "Connect
# Shopify" button stays disabled until an operator provisions the tenant's
# own custom app via PUT /admin/tenants/:id/shopify-app. Leave blank/false
# for the SaaS path (Connect always available). Per-tenant credential
# resolution is automatic regardless of this flag (a provisioning row wins;
# otherwise the SHOPIFY_APP_CLIENT_ID/SECRET above are used).
SHOPIFY_CONNECT_REQUIRES_PROVISIONING=

# Local/dev only. Set to 1 to allow http callback URLs outside NODE_ENV=test.
ALLOW_HTTP_CALLBACK=

# ---- Google OAuth, Gmail webhooks, and Google Sheets install ----------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://<api-host>/google/auth/callback

# Gmail Pub/Sub watch topic and push-token secret. Optional unless Gmail
# inbound webhooks are enabled.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_TOKEN=

# ---- Microsoft OAuth (Outlook / O365 conversation connector) ----------------
# Set all three to enable the /microsoft/install + /microsoft/auth/callback
# routes. MICROSOFT_OAUTH_TENANT defaults to "common" (multi-tenant). The
# NOTIFICATION_URL + WEBHOOK_SECRET drive the inbound Graph subscription
# (added with the Outlook webhook) — leave blank until then.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CALLBACK_URL=https://<api-host>/microsoft/auth/callback
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_GRAPH_NOTIFICATION_URL=
MICROSOFT_GRAPH_WEBHOOK_SECRET=

# ---- Telegram merchant notifications (optional) -----------------------------
# Platform bot for merchant chat notifications. All three must be set together
# (or all unset to disable) and match apps/worker. The webhook secret is the
# X-Telegram-Bot-API-Secret-Token value passed to Telegram's setWebhook for
# POST /webhooks/notifications/telegram — the webhook rejects calls without it.
# TELEGRAM_BOT_USERNAME is the bot's @username WITHOUT the @ (deep links).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---- Object storage (Cloudflare R2) ----------------------------------------
# Optional. When R2_BUCKET is unset, apps/api uses in-memory BlobStorageTest.
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL_BASE=
R2_REGION=auto
