# Dashboard env vars. Next.js reads this directory's `.env.local`
# (NOT the repo root's), so copy/symlink this file as `.env.local`
# in apps/dashboard/ before `pnpm dev`. The root `.env.example` is
# the canonical reference for the rest of the platform (worker, api,
# providers); this file lists only what the dashboard process reads.

# ---- Postgres -------------------------------------------------------------
# Same database as the worker and apps/api. Dashboard reads case /
# audit / approval rows directly through Drizzle (lib/db.ts).
DATABASE_URL=postgres://support_agent:support_agent@localhost:5432/support_agent

# ---- WorkOS AuthKit (sign-in) ---------------------------------------------
# Used by @workos-inc/authkit-nextjs for SSO. Configure the redirect
# URI in the WorkOS dashboard to match NEXT_PUBLIC_WORKOS_REDIRECT_URI
# exactly. `WORKOS_COOKIE_PASSWORD` must be at least 32 chars
# (e.g. `openssl rand -base64 24`).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Dev-only bypass: when set in non-production, skip WorkOS sign-in
# and treat every request as authenticated for this tenant. Lets a
# local developer browse the dashboard without configuring WorkOS.
# Explicitly ignored when NODE_ENV=production.
DASHBOARD_DEV_TENANT_ID=

# ---- apps/api base URL ----------------------------------------------------
# Public origin of apps/api as the dashboard's browser sees it. Used
# to build "Connect Shopify" / "Connect Gmail" install links on the
# integrations settings page. When unset, those buttons are disabled
# with a banner explaining why. No trailing slash.
# Example: DASHBOARD_API_BASE_URL=https://support-agent-api.nacirianas.com
DASHBOARD_API_BASE_URL=

# ---- Shopify panels on case detail ---------------------------------------
# AES-256-GCM key (base64) for decrypting per-tenant Shopify tokens
# stored in `connector_connections.access_token_encrypted`. Same value
# as the worker uses. When unset, Shopify panels degrade to "not
# connected" copy on the case detail page. Generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
