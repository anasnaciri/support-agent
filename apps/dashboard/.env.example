# Dashboard env vars. Next.js reads this directory's `.env.local`, so copy
# this file as `.env.local` in apps/dashboard/ before `pnpm dev`. This file
# lists only what the dashboard process reads.
#
# Since Path B the dashboard is a PURE api client: every read/write goes
# through apps/api over HTTPS. It no longer touches Postgres or decrypts
# credentials, so there is NO DATABASE_URL and NO CREDENTIAL_ENCRYPTION_KEY
# here. For deploying this as a Node service, see DEPLOY.md "apps/dashboard"
# and DEPLOY.md.

# ---- WorkOS AuthKit (sign-in) ---------------------------------------------
# Used by @workos-inc/authkit-nextjs for SSO. Configure the redirect
# URI in the WorkOS dashboard to match NEXT_PUBLIC_WORKOS_REDIRECT_URI
# exactly. `WORKOS_COOKIE_PASSWORD` must be at least 32 chars
# (e.g. `openssl rand -base64 24`).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# ---- apps/api connection (Path B) -----------------------------------------
# Public origin of apps/api the dashboard fetches (reads + writes + connect
# links). No trailing slash. When unset, the integrations Connect buttons are
# disabled with a banner explaining why.
# Example: DASHBOARD_API_BASE_URL=https://support-agent-api.nacirianas.com
DASHBOARD_API_BASE_URL=
# Auth to apps/api is the merchant's WorkOS access token (forwarded from the
# session, verified api-side — audit S14). No shared service token is needed;
# the api's WORKOS_CLIENT_ID must match this app's WORKOS_CLIENT_ID below.

# ---- Integrations page display origins (optional) -------------------------
# Used only to show the api/callback origins on the integrations settings page;
# the actual connect links come from apps/api. Safe to leave unset locally.
SHOPIFY_APP_CALLBACK_URL=
GOOGLE_OAUTH_CALLBACK_URL=
APPROVAL_BASE_URL=
