# apps/admin — platform-operator console
# Hosts separately from the api (like apps/dashboard). Auth is a single
# shared operator password; the app holds ADMIN_API_TOKEN server-side and
# calls apps/api's /admin/* endpoints with it.

# Shared operator login password (gates the whole app).
ADMIN_DASHBOARD_PASSWORD=

# HMAC signing key for the session cookie. Generate: openssl rand -hex 32.
ADMIN_SESSION_SECRET=

# Bearer token the admin app sends to apps/api /admin/* — MUST equal the
# api's ADMIN_API_TOKEN.
ADMIN_API_TOKEN=

# Public origin of apps/api, e.g. https://api.example.com.
ADMIN_API_BASE_URL=
