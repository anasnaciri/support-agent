# Copy this file to `apps/worker/.env.local` or export the values in your
# process manager. Keep real secrets out of git.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgres://support_agent:support_agent@localhost:5432/support_agent

# Production/BYOK path. 32-byte AES-256-GCM key, base64-encoded. Must match
# apps/api/dashboard so connector credentials and tenant LLM keys decrypt.
CREDENTIAL_ENCRYPTION_KEY=

# Dev-only LLM fallback. If CREDENTIAL_ENCRYPTION_KEY is unset, the worker
# requires OPENROUTER_API_KEY and uses it for every tenant.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# ---- Shopify ---------------------------------------------------------------
# Dev/test only. Used when CREDENTIAL_ENCRYPTION_KEY is unset and the worker
# falls back to ShopifyCredentialStoreFromEnv.
SHOPIFY_TEST_SHOP_DOMAIN=
SHOPIFY_TEST_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04

# ---- Customer conversations and Google Sheets ------------------------------
# Optional. Enables GmailConversationLive and SheetsServiceLive when paired
# with CREDENTIAL_ENCRYPTION_KEY. GMAIL_PUBSUB_TOPIC also enables the Gmail
# watch-renewal cron.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=

# ---- Approval-link mail ----------------------------------------------------
# APPROVAL_SIGNING_KEY must match apps/api so the API can verify links signed
# by the worker. APPROVAL_BASE_URL should point at the public API origin.
APPROVAL_SIGNING_KEY=
APPROVAL_BASE_URL=http://localhost:4000

# Optional. When both are set, approval-link emails are sent through Resend;
# otherwise PlatformMailServiceTest is used.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ---- Tracking lookup -------------------------------------------------------
# Optional platform-managed 17track key. When unset, tracking.lookup returns a
# no_provider result with a public tracking URL.
SEVENTEENTRACK_API_KEY=

# ---- Object storage (Cloudflare R2) ----------------------------------------
# Optional. When R2_BUCKET is unset, the worker uses in-memory BlobStorageTest.
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL_BASE=
R2_REGION=auto

# ---- Audit log -------------------------------------------------------------
# Set to 1 in production to redact known PII from audit_log.details.
AUDIT_LOG_REDACT_PII=
