# Copy this file to `apps/worker/.env.local` or export the values in your
# process manager. Keep real secrets out of git.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgres://support_agent:support_agent@localhost:5432/support_agent

# Production/BYOK path. 32-byte AES-256-GCM key, base64-encoded. Must match
# apps/api so connector credentials and tenant LLM keys decrypt.
CREDENTIAL_ENCRYPTION_KEY=

# Dev-only LLM fallback. If CREDENTIAL_ENCRYPTION_KEY is unset, the worker
# requires OPENROUTER_API_KEY and uses it for every tenant.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# ---- Shopify ---------------------------------------------------------------
# Dev/test only. Used when CREDENTIAL_ENCRYPTION_KEY is unset and the worker
# falls back to ShopifyCredentialStoreFromEnv.
SHOPIFY_TEST_SHOP_DOMAIN=
SHOPIFY_TEST_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04

# ---- Customer conversations and Google Sheets ------------------------------
# Optional. Enables GmailConversationLive and SheetsServiceLive when paired
# with CREDENTIAL_ENCRYPTION_KEY. GMAIL_PUBSUB_TOPIC also enables the Gmail
# watch-renewal cron.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=

# Optional. Enables the Outlook / O365 connector in the conversation router
# when paired with CREDENTIAL_ENCRYPTION_KEY (so the agent can send replies +
# fetch threads). Use the SAME Microsoft app as apps/api — the worker refreshes
# tokens that app issued. MICROSOFT_OAUTH_TENANT defaults to "common".
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# Required for the graph.subscription-renewal cron (renews Graph subscriptions
# before their ~3-day lease lapses, and creates one if missing). The cron is
# skipped unless BOTH are set. MICROSOFT_GRAPH_WEBHOOK_SECRET MUST be identical
# to apps/api's value — the api webhook rejects notifications whose clientState
# doesn't match. MICROSOFT_GRAPH_NOTIFICATION_URL is the same public api URL.
MICROSOFT_GRAPH_NOTIFICATION_URL=
MICROSOFT_GRAPH_WEBHOOK_SECRET=

# ---- Approval-link mail ----------------------------------------------------
# APPROVAL_SIGNING_KEY must match apps/api so the API can verify links signed
# by the worker. APPROVAL_BASE_URL should point at the public API origin.
APPROVAL_SIGNING_KEY=
APPROVAL_BASE_URL=http://localhost:4000

# Production requires Resend by default. Set PLATFORM_MAIL_ENABLED=false only
# when intentionally running without approval-link, deletion-confirmation, and
# other platform-originated emails; dashboard approvals still work.
PLATFORM_MAIL_ENABLED=true
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ---- Merchant notifications (Telegram) --------------------------------------
# Optional platform bot pinging merchants on Telegram (approval requests,
# human-takeover escalations, broken connectors, low LLM credits, and the
# agent's merchant.notify tool). All three must be set together and match
# apps/api; unset → notifications are disabled (no-op layer). The chat
# bindings live in connector_connections, so CREDENTIAL_ENCRYPTION_KEY is
# also required for the Live layer.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Alert when an OpenRouter BYOK balance drops under this many USD (default 5).
LLM_CREDITS_ALERT_THRESHOLD_USD=5

# ---- Account-deletion cleanup ----------------------------------------------
# WorkOS secret key. Used by the account-cleanup job to delete a tenant's
# WorkOS organization after account deletion. Without it, org deletion is
# skipped (the DB wipe + deletion email still run).
WORKOS_API_KEY=

# ---- Tracking lookup -------------------------------------------------------
# Optional platform-managed 17track key. When unset, tracking.lookup returns a
# no_provider result with a public tracking URL.
SEVENTEENTRACK_API_KEY=

# ---- Object storage (Cloudflare R2) ----------------------------------------
# Optional. When R2_BUCKET is unset, the worker uses in-memory BlobStorageTest.
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL_BASE=
R2_REGION=auto

# ---- Audit log -------------------------------------------------------------
# Set to 1 in production to redact known PII from audit_log.details.
AUDIT_LOG_REDACT_PII=
