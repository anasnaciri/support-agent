# Build context excludes. Keep this in sync with what the image needs:
# source + manifests + lockfile + drizzle migrations are required; built
# output and host-installed modules are NOT (the image reinstalls + rebuilds
# for its own architecture).

# Host node_modules carry darwin/arm64 native binaries — never copy them into
# the linux image; pnpm install rebuilds them inside the builder.
**/node_modules

# Compiled output is regenerated by `pnpm build` in the builder stage. Copying
# stale host dist would shadow the fresh build.
**/dist
**/.next
**/.turbo
**/*.tsbuildinfo

# VCS + local tooling
.git
.githooks
.vscode
.idea

# Secrets / local env (never bake into an image layer)
**/.env
**/.env.*
!**/.env.example

# Test + coverage noise
**/coverage
**/*.log

# Operator-local infra that isn't part of the app image
cloudflared
