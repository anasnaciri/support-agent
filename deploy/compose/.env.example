# Production environment for docker-compose.prod.yml.
#
#   cp deploy/compose/.env.example deploy/compose/.env
#   # then fill every CHANGE_ME
#
# This deploy-local file serves two roles, so always run compose with
# `--env-file deploy/compose/.env`:
#   1. Compose-level ${VAR} substitution (POSTGRES_*, API_DOMAIN, ACME_EMAIL).
#   2. Container runtime env for api/worker/migrate (via `env_file:`).
#
# NOTE: env_file values are literal — no ${VAR} expansion inside this file.
# Where one value embeds another (DATABASE_URL embeds the POSTGRES_* creds,
# the callback URLs embed API_DOMAIN), you must keep them in sync by hand.
#
# Secret generation:
#   CREDENTIAL_ENCRYPTION_KEY   openssl rand -base64 32   (32 bytes, base64)
#   STATE_SIGNING_KEY           openssl rand -hex 32
#   APPROVAL_SIGNING_KEY        openssl rand -hex 32
#   GMAIL_PUSH_TOKEN            openssl rand -hex 32
#   POSTGRES_PASSWORD          openssl rand -hex 24

# ===========================================================================
# Host / proxy (compose-level substitution)
# ===========================================================================
# Public domain for the api. Must be a DNS-only A record pointing at this box
# for Caddy's Let's Encrypt challenge (see deploy/Caddyfile).
API_DOMAIN=api.example.com
# Contact email Let's Encrypt uses for expiry notices.
ACME_EMAIL=ops@example.com

# ===========================================================================
# Postgres (compose-level substitution + must match DATABASE_URL below)
# ===========================================================================
POSTGRES_USER=support_agent
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=support_agent

# ===========================================================================
# Shared app runtime (api + worker)
# ===========================================================================
NODE_ENV=production
LOG_LEVEL=info

# The host is `postgres` — the compose service name on the internal network.
# Keep user/password/db in sync with the POSTGRES_* values above.
DATABASE_URL=postgres://support_agent:CHANGE_ME_strong_db_password@postgres:5432/support_agent

# 32-byte AES-256-GCM key, base64. Encrypts connector credentials + tenant
# BYOK LLM keys. Shared by api + worker. Primary key — used to ENCRYPT.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
# Key rotation (audit S15). Optional, comma-separated OLD base64 keys reads
# still fall back to. To rotate WITHOUT orphaning credentials: put the NEW key
# in CREDENTIAL_ENCRYPTION_KEY and move the OLD key here. Reads decrypt against
# both; each row re-encrypts to the new key on its next write. Drop a key from
# this list once nothing is still encrypted under it. Empty when not rotating.
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# HMAC keys. APPROVAL_SIGNING_KEY MUST be identical for api + worker (worker
# signs approval links, api verifies them).
STATE_SIGNING_KEY=CHANGE_ME_hex_32_bytes
APPROVAL_SIGNING_KEY=CHANGE_ME_hex_32_bytes

# Public origin of the dashboard (Cloudflare Workers). A successful connector
# OAuth callback redirects the merchant here to /settings/integrations.
DASHBOARD_BASE_URL=https://app.example.com

# WorkOS verification for /dashboard/* (Path B, audit S14). The dashboard
# forwards the merchant's WorkOS access token; the api verifies it against this
# client's JWKS — no shared service token. Set to the SAME WorkOS client id the
# dashboard uses. Blank → /dashboard/* responds 503.
WORKOS_CLIENT_ID=client_CHANGE_ME

# Bearer token guarding the platform-operator admin endpoints (api), e.g.
# POST /admin/tenants/:id/delete (delete ANY tenant's account). Admin keeps the
# shared-token model. openssl rand -hex 32. Leave blank to disable the admin
# routes (they respond 503).
ADMIN_API_TOKEN=CHANGE_ME_hex_32_bytes

# Public api origin used to build approval-link emails (worker).
APPROVAL_BASE_URL=https://api.example.com

# ===========================================================================
# Shopify app (custom-distribution pilot — see todo.md launch checklist)
# ===========================================================================
# This is a pure-pilot deployment (every tenant on its own provisioned custom
# app), so the global CLIENT_ID/SECRET MUST be left blank — pilot mode forbids
# a global app and the api won't boot if they're set with the pilot flag below
# (audit A6). CALLBACK_URL/API_VERSION are always required.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_APP_CALLBACK_URL=https://api.example.com/shopify/auth/callback
SHOPIFY_API_VERSION=2026-04
# Pilot custom distribution: `true` gates the dashboard "Connect Shopify"
# button until an operator provisions the tenant's own custom app via
# PUT /admin/tenants/:id/shopify-app. Blank/false = SaaS self-serve. Per-
# tenant credential resolution happens regardless (a provisioning row wins;
# otherwise the SHOPIFY_APP_CLIENT_ID/SECRET above are the fallback app).
SHOPIFY_CONNECT_REQUIRES_PROVISIONING=true

# ===========================================================================
# Google OAuth — Gmail connector + Google Sheets (optional but needed for the
# Gmail mailbox connector and fulfillment-operator-sheet escalation)
# ===========================================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://api.example.com/google/auth/callback
# Gmail Pub/Sub watch topic + push-secret. Required for inbound Gmail.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_TOKEN=

# ===========================================================================
# LLM (worker). Production is BYOK per-tenant via CREDENTIAL_ENCRYPTION_KEY;
# this platform key is only a dev/fallback and can stay blank in prod.
# ===========================================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# ===========================================================================
# Object storage (Cloudflare R2) — image attachments (Gmail) + DB backups.
# Required for damaged-product photo handling; recommended in prod.
# ===========================================================================
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL_BASE=
R2_REGION=auto

# ===========================================================================
# Platform mail (Resend) — approval-link / system emails only, never customer
# replies. Optional; without it approval links are logged, not emailed.
# ===========================================================================
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# WorkOS secret key (worker + api). Worker: delete a tenant's WorkOS org during
# account cleanup (without it, org deletion is skipped; the DB wipe + email still
# run). Api: resolve a member's verified email (from the verified sub) for invite
# reconcile, so /me/session never trusts the x-user-email header (S14). Same key
# the dashboard uses for auth.
WORKOS_API_KEY=

# ===========================================================================
# Optional extras
# ===========================================================================
# Platform-managed 17track key for carrier-level tracking lookups.
SEVENTEENTRACK_API_KEY=
# Set to 1 to redact known PII from audit_log.details in production.
AUDIT_LOG_REDACT_PII=1
