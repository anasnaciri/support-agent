{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/Dockerfile"
  },
  "deploy": {
    "startCommand": "node apps/api/dist/server.js",
    "preDeployCommand": "sh -lc 'cd packages/db && pnpm db:migrate && cd /app && pnpm --filter @support-agent/api reconcile:shopify-shipments'",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
