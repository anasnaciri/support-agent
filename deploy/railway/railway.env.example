# Railway environment for support-agent (api + worker services).
#
# This is the Railway-specific backend runtime template, where:
#   - Postgres is a managed plugin (no POSTGRES_* / DATABASE_URL host to run).
#   - TLS + domains are managed by Railway (no API_DOMAIN / ACME_EMAIL / Caddy).
#   - The api binds Railway's injected $PORT via API_PORT (see below).
#
# Values like ${{ ... }} are Railway variable references — paste them verbatim;
# Railway resolves them at deploy time. See DEPLOY.md "Railway (primary)".
#
# WHERE EACH VAR GOES:
#   [shared]  set as a Railway *shared variable* (project level) and referenced
#             by both services, OR set identically on api AND worker.
#   [api]     set on the api service only.
#   [worker]  set on the worker service only.

# === Database (both services) ===============================================
# Reference the managed Postgres plugin. Add a Postgres service to the project,
# then this resolves to its private-network connection string.
# [shared]
DATABASE_URL=${{ Postgres.DATABASE_URL }}

# === Port (api only) ========================================================
# Fastify reads API_PORT; Railway injects $PORT. Map them so the api listens on
# the port Railway routes to. The worker has no port.
# [api]
API_PORT=${{ PORT }}

# === Runtime role (worker only) =============================================
# The Railway image defaults to the api role and runs migrations before api
# startup. Set this only on the worker service.
# [worker]
DEPLOY_ROLE=worker

# === Shared app runtime =====================================================
# [shared]
NODE_ENV=production
LOG_LEVEL=info
# 32-byte AES-256-GCM key, base64. openssl rand -base64 32. Identical on api +
# worker. Primary key — used to ENCRYPT.
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
# Key rotation (audit S15). Optional, comma-separated OLD base64 keys reads
# still fall back to. To rotate WITHOUT orphaning credentials: put the NEW key
# in CREDENTIAL_ENCRYPTION_KEY and move the OLD key here. Reads decrypt against
# both; each row re-encrypts to the new key on its next write. Drop a key once
# nothing is still encrypted under it. Empty when not rotating.
CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
# openssl rand -hex 32. APPROVAL_SIGNING_KEY MUST match across api + worker
# (worker signs approval links, api verifies them).
STATE_SIGNING_KEY=CHANGE_ME_hex_32_bytes
APPROVAL_SIGNING_KEY=CHANGE_ME_hex_32_bytes

# Public origins. Set these once the api custom domain + dashboard exist.
# [api] redirect target after a successful connector OAuth.
DASHBOARD_BASE_URL=https://app.example.com
# [worker] base used to build approval-link emails — the api custom domain.
APPROVAL_BASE_URL=https://api.example.com

# WorkOS client id the api verifies forwarded dashboard access tokens against
# (Path B, audit S14). Same value as the dashboard's WORKOS_CLIENT_ID. [api]
WORKOS_CLIENT_ID=client_CHANGE_ME
# Bearer for the operator admin endpoints (api) incl. Shopify provisioning +
# the PCD check. Blank disables them (503). openssl rand -hex 32. [api]
ADMIN_API_TOKEN=CHANGE_ME_hex_32_bytes

# === Shopify (custom-distribution pilot) ====================================
# This is a pure-pilot deployment: every tenant uses its own operator-
# provisioned custom app, so a global/SaaS app is FORBIDDEN here. The global
# CLIENT_ID/SECRET MUST be left blank — the api fails to boot if they are set
# alongside SHOPIFY_CONNECT_REQUIRES_PROVISIONING=true (audit A6). [shared]
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_APP_CALLBACK_URL=https://api.example.com/shopify/auth/callback
SHOPIFY_API_VERSION=2026-04
# true = gate the dashboard Connect button until an operator provisions the
# tenant's own custom app (the pilot). [shared]
SHOPIFY_CONNECT_REQUIRES_PROVISIONING=true

# === Google OAuth — Gmail + Sheets (optional) ===============================
# [shared]
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://api.example.com/google/auth/callback
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_TOKEN=

# === LLM (worker) — BYOK per tenant; platform key optional ==================
# [worker]
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# === Object storage (Cloudflare R2) — image attachments + backups ===========
# [shared]
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL_BASE=
R2_REGION=auto

# === Platform mail (Resend) — approval/system emails only ===================
# [worker] Production requires Resend by default. For an initial pilot that
# intentionally uses dashboard approvals only, set PLATFORM_MAIL_ENABLED=false;
# approval-link, account-deletion, and other platform emails will not be sent.
PLATFORM_MAIL_ENABLED=true
# [worker]
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# === WorkOS API key ========================================================
# worker: account-cleanup org delete. api: resolve a member's verified email
# (from the verified sub) for invite reconcile, so /me/session never trusts the
# x-user-email header (S14). Same key the dashboard uses. [worker, api]
WORKOS_API_KEY=

# === Optional extras ========================================================
# [shared]
SEVENTEENTRACK_API_KEY=
AUDIT_LOG_REDACT_PII=1
