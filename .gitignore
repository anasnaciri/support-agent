node_modules/
dist/
.next/
# OpenNext → Cloudflare Workers build output + local wrangler state/secrets.
.open-next/
.wrangler/
.dev.vars
cloudflare-env.d.ts
*.tsbuildinfo
# Real env files stay local; only ownership-scoped templates are committed.
.env*
