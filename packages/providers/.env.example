# packages/providers smoke-test environment
#
# Copy to `packages/providers/.env.local`. `pnpm llm:smoke` loads it
# automatically when it exists. These values are for package-level provider
# smoke tests only; app runtime credentials belong to the consuming app.

OPENROUTER_API_KEY=
OPENROUTER_SMOKE_MODEL=google/gemini-3.1-flash-lite
# Optional; when unset the smoke script uses its built-in prompt.
# OPENROUTER_SMOKE_PROMPT=Say hello and nothing else.

# Optional Shopify Live smoke-test credentials.
SHOPIFY_TEST_SHOP_DOMAIN=
SHOPIFY_TEST_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04
