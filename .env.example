# Copy to `.env.local` (gitignored) and fill in real values.
# `.env.example` is the only env file checked into git.

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgres://support_agent:support_agent@localhost:5432/support_agent

# ---- Workflow queue (pg-boss uses DATABASE_URL by default) -----------------
# PGBOSS_SCHEMA=pgboss

# ---- LLM (Vercel AI SDK + OpenRouter) --------------------------------------
OPENROUTER_API_KEY=
# Optional: site identification headers OpenRouter recommends
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# ---- Email outbound (platform-originated mail) -----------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ---- Email inbound (tenant mailbox via Gmail OAuth) ------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/google/callback
# Pub/Sub topic the Gmail watch publishes to
GMAIL_PUBSUB_TOPIC=

# ---- Shopify ---------------------------------------------------------------
# Per-tenant credentials are stored in the DB; these are platform-level
# (e.g. for app registration / partner API)
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=

# ---- Webhook signing -------------------------------------------------------
# HMAC secret used to verify inbound webhooks at the API edge
WEBHOOK_HMAC_SECRET=

# ---- OpenTelemetry ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=support-agent

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
