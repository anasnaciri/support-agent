# Copy this file to `.env.local` (gitignored) and fill in real values.
# `.env.example` is the only env file checked into git. Do not put real
# secrets in this file.
#
# Minimal local worker config with BYOK:
#   DATABASE_URL
#   CREDENTIAL_ENCRYPTION_KEY
#   NODE_ENV
#   LOG_LEVEL
# Tenant LLM keys are saved through the dashboard at `/settings/llm` and
# read from the DB-backed connector credential store.

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgres://support_agent:support_agent@localhost:5432/support_agent

# ---- Workflow queue (pg-boss uses DATABASE_URL by default) -----------------
# PGBOSS_SCHEMA=pgboss

# ---- LLM -------------------------------------------------------------------
# BYOK path: tenants bring their own keys via `/settings/llm`. Keys are stored
# encrypted in `connector_connections` and resolved per call. This path requires
# CREDENTIAL_ENCRYPTION_KEY below and does NOT require OPENROUTER_API_KEY.
#
# Legacy dev-only fallback: if CREDENTIAL_ENCRYPTION_KEY is unset and
# OPENROUTER_API_KEY is present, the worker uses this one env key for every
# tenant. Leave empty when using BYOK.
OPENROUTER_API_KEY=
# Optional: override the OpenRouter base URL (e.g. for a regional proxy)
OPENROUTER_BASE_URL=
# Optional: site identification headers OpenRouter recommends
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# ---- Email outbound (platform-originated mail) -----------------------------
# Used by `PlatformMailService` (approval-link emails, manager invites,
# billing notices). NEVER used for customer replies — those go through
# the tenant's connected mailbox via `ConversationService`.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ---- 17track (platform-managed tracking lookup) ----------------------------
# Optional. When set, the `tracking.lookup` tool (used by order-status-agent)
# resolves carrier-side shipment status via 17track's API. When UNSET, the
# tool returns `{ kind: "no_provider", trackingUrl: <public 17track URL> }`
# and the agent falls back to that URL in the customer reply. This is a
# single platform-shared key — NOT per-tenant. Merchants don't see this.
SEVENTEENTRACK_API_KEY=

# ---- Dashboard (WorkOS AuthKit) --------------------------------------------
# Used by apps/dashboard for SSO. Configure the redirect URI in the
# WorkOS dashboard to match NEXT_PUBLIC_WORKOS_REDIRECT_URI exactly.
# `WORKOS_COOKIE_PASSWORD` must be at least 32 chars (e.g.
# `openssl rand -base64 24`). The dashboard reads Postgres directly
# via DATABASE_URL above — no separate DB credential.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Dev-only bypass: when set in non-production, skip WorkOS sign-in
# and treat every request as authenticated for this tenant. Lets a
# local developer browse the dashboard without configuring WorkOS.
# Explicitly ignored when NODE_ENV=production.
DASHBOARD_DEV_TENANT_ID=

# Public origin of apps/api as the dashboard's browser sees it. Used to
# build "Connect Shopify" / "Connect Gmail" install links on the
# integrations settings page. When unset, the dashboard falls back to
# the origin of SHOPIFY_APP_CALLBACK_URL, GOOGLE_OAUTH_CALLBACK_URL, or
# APPROVAL_BASE_URL. Example:
#   DASHBOARD_API_BASE_URL=https://support-agent-api.nacirianas.com
DASHBOARD_API_BASE_URL=

# ---- Audit log -------------------------------------------------------------
# When set to "1", every audit_log insert has its `details` payload
# scrubbed of PII (customer email / phone / name / address / message
# bodies) before persistence. Recommended in production. Default unset
# preserves full debug fidelity for development.
AUDIT_LOG_REDACT_PII=

# ---- Approval-link tokens --------------------------------------------------
# HMAC secret used to sign + verify approve/reject URLs in approval
# emails. MUST be the same value in apps/worker (signs) and apps/api
# (verifies). Rotate by reissuing pending approvals before swap.
APPROVAL_SIGNING_KEY=
# Public base URL for `/approvals/:id/(approve|reject)` links. The
# worker mints these into outbound approval emails. Must point at the
# API origin reachable from the operator's email client.
APPROVAL_BASE_URL=http://localhost:4000

# ---- Email inbound (tenant mailbox via Gmail OAuth) ------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI in the Google Cloud
# OAuth client. Path is /google/auth/callback (defined in
# apps/api/src/server.ts). Google requires https except for the
# http://localhost loopback case. For local dev: either expose apps/api
# through the Cloudflare Tunnel in cloudflared/ (recommended), or
# use http://localhost:4000/google/auth/callback and set
# ALLOW_HTTP_CALLBACK=1 to bypass the bootstrap's https assertion.
GOOGLE_OAUTH_CALLBACK_URL=https://<your-tunnel-host>/google/auth/callback
# Pub/Sub topic the Gmail watch publishes to. One topic/subscription can serve
# every tenant; the API resolves the tenant from the Gmail emailAddress in each
# Pub/Sub message. Push endpoint:
#   https://<api-host>/webhooks/conversations/gmail?token=<GMAIL_PUSH_TOKEN>
GMAIL_PUBSUB_TOPIC=
# Shared secret in the Pub/Sub push URL (`?token=...`).
GMAIL_PUSH_TOKEN=

# ---- Object storage (Cloudflare R2) ----------------------------------------
# The Gmail webhook uploads image attachments here so the LLM can read them
# back as multimodal parts (damaged-product flow). When R2_BUCKET is set the
# worker + apps/api both wire `BlobStorageLive` over `BlobStorageConfigFromEnv`.
# When R2_BUCKET is unset, both fall back to an in-memory `BlobStorageTest`
# layer — fine for dev / CI; image attachments are dropped on process restart.
# R2 region is always `auto`; the SDK requires the value to be set anyway.
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional. Public-URL prefix for presigned reads when fronted by a custom
# domain (e.g. https://blobs.example.com). Defaults to R2_ENDPOINT.
R2_PUBLIC_URL_BASE=
R2_REGION=auto

# ---- Shopify ---------------------------------------------------------------
# Platform-level credentials for OUR managed Shopify app. Power the
# `GET /shopify/install` and `GET /shopify/auth/callback` routes in apps/api.
# Access scopes are configured in Shopify's Partner Dashboard ("Required
# access scopes"); the dashboard is the binding source of truth and
# auto-prompts existing merchants to update permissions when changed.
# Today we expect: read_orders, read_customers, write_orders.
# `SHOPIFY_APP_CALLBACK_URL` must exactly match an Allowed Redirect URL
# configured in the Partner Dashboard AND must use https — Shopify rejects
# http:// callbacks, including http://localhost. For local dev we expose
# the API via the Cloudflare Tunnel in `cloudflared/` (see its README).
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_APP_CALLBACK_URL=https://support-agent-api.nacirianas.com/shopify/auth/callback
# Dev/test only: single-tenant credentials read by
# `ShopifyCredentialStoreFromEnv` when CREDENTIAL_ENCRYPTION_KEY is unset.
# When the encryption key IS set, the worker reads per-tenant credentials
# from the DB-backed ConnectorCredentialStore (populated by the install
# callback) and these env vars are ignored.
# IMPORTANT: bare domain — no `https://`, no trailing `/`.
#   correct:  support-agent-test.myshopify.com
#   wrong:    https://support-agent-test.myshopify.com/
SHOPIFY_TEST_SHOP_DOMAIN=
SHOPIFY_TEST_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04

# ---- Connector credential store --------------------------------------------
# 32-byte AES-256-GCM key, base64-encoded. Encrypts access tokens stored in
# the `connector_connections` table (Shopify, Gmail, AND per-tenant LLM
# provider keys — see /settings/llm in the dashboard). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required for BYOK and production. Keep this value stable across api,
# dashboard, and worker; changing it makes previously encrypted connector
# credentials unreadable. When unset, the worker can only use legacy
# single-tenant env fallbacks.
CREDENTIAL_ENCRYPTION_KEY=
# Separate HMAC key used to sign the OAuth `state` parameter so the callback
# can recover the tenantId and reject tampered states.
STATE_SIGNING_KEY=

# ---- API server ------------------------------------------------------------
API_PORT=4000

# ---- Webhook signing -------------------------------------------------------
# HMAC secret used to verify inbound webhooks at the API edge
WEBHOOK_HMAC_SECRET=

# ---- OpenTelemetry ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=support-agent

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
